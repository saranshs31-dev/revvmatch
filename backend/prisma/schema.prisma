generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model generations {
  id            Int             @id @default(autoincrement())
  model_id      Int
  name          String          @db.VarChar(50)
  slug          String          @db.VarChar(50)
  year_start    Int?
  year_end      Int?
  models        models          @relation(fields: [model_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  part_fitments part_fitments[]
}

model makes {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(50)
  slug   String   @unique @db.VarChar(50)
  models models[]
}

model models {
  id          Int           @id @default(autoincrement())
  make_id     Int
  name        String        @db.VarChar(50)
  slug        String        @db.VarChar(50)
  generations generations[]
  makes       makes         @relation(fields: [make_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model part_fitments {
  id            Int         @id @default(autoincrement())
  part_id       Int
  generation_id Int
  generations   generations @relation(fields: [generation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parts         parts       @relation(fields: [part_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model parts {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(100)
  manufacturer  String          @db.VarChar(100)
  category      String          @db.VarChar(50)
  price         Decimal         @db.Decimal(10, 2)
  image_path    String?         @db.VarChar(255)
  fitment_note  String?
  origin        String?         @db.VarChar(100)
  cart_items    cart_items[]
  part_fitments part_fitments[]
}

model users {
  id            Int          @id @default(autoincrement())
  name          String       @db.VarChar(100)
  email         String       @unique @db.VarChar(150)
  password_hash String       @db.VarChar(255)
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  cart_items    cart_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cart_items {
  id         Int       @id @default(autoincrement())
  user_id    Int
  part_id    Int
  quantity   Int       @default(1)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  parts      parts     @relation(fields: [part_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, part_id])
}
